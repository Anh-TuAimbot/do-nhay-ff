<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tra Cứu Độ Nhạy, Nút Bắn & DPI Free Fire</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background: linear-gradient(135deg, #1e1e2f, #11111d);
            color: #fff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            background: #282a36;
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            width: 100%;
            max-width: 480px;
            text-align: center;
        }
        h1 {
            color: #ffb86c;
            font-size: 22px;
            margin-bottom: 20px;
            text-transform: uppercase;
        }
        .input-group {
            margin-bottom: 20px;
            text-align: left;
        }
        label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            color: #bd93f9;
        }
        input {
            width: 100%;
            padding: 12px;
            border: 2px solid #44475a;
            border-radius: 8px;
            background: #44475a;
            color: #fff;
            font-size: 16px;
            outline: none;
            transition: 0.3s;
        }
        input:focus {
            border-color: #ff79c6;
        }
        button {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 8px;
            background: #ff79c6;
            color: #fff;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }
        button:hover {
            background: #ff92d0;
        }
        .result-box {
            margin-top: 25px;
            padding: 15px;
            background: #343746;
            border-radius: 10px;
            display: none;
            text-align: left;
        }
        .result-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid #44475a;
        }
        .result-item:last-child {
            border-bottom: none;
        }
        .result-title {
            color: #50fa7b;
            font-weight: bold;
        }
        .device-name {
            color: #ffb86c;
            font-weight: bold;
            font-size: 18px;
            margin-bottom: 15px;
            text-align: center;
        }
        .highlight-box {
            background: #44475a;
            padding: 10px;
            border-radius: 6px;
            margin-top: 8px;
        }
        .dpi-box {
            background: #ffb86c;
            color: #1e1e2f;
            padding: 10px;
            border-radius: 6px;
            margin-top: 8px;
            font-weight: bold;
        }
    </style>
</head>
<body>

<div class="container">
    <h1>Độ Nhạy & DPI Free Fire</h1>
    
    <div class="input-group">
        <label for="deviceInput">Nhập tên thiết bị (Ví dụ: iPhone 13, Redmi Note 11, Realme Q3...):</label>
        <input type="text" id="deviceInput" placeholder="Tên dòng máy..." onkeyup="checkEnter(event)">
    </div>
    
    <button onclick="getSensitivity()">Lấy Cấu Hình Độ Nhạy</button>

    <div class="result-box" id="resultBox">
        <div class="device-name" id="resDevice">iPhone 11</div>
        
        <div class="result-item">
            <span>Nhìn xung quanh (0-200):</span>
            <span class="result-title" id="resLook">195</span>
        </div>
        <div class="result-item">
            <span>Red Dot Sight (0-200):</span>
            <span class="result-title" id="resRedDot">185</span>
        </div>
        <div class="result-item">
            <span>Ống ngắm 2x (0-200):</span>
            <span class="result-title" id="res2x">175</span>
        </div>
        <div class="result-item">
            <span>Ống ngắm 4x (0-200):</span>
            <span class="result-title" id="res4x">165</span>
        </div>
        <div class="result-item">
            <span>Ống ngắm Sniper (0-200):</span>
            <span class="result-title" id="resSniper">120</span>
        </div>
        <div class="result-item">
            <span>Góc nhìn (0-200):</span>
            <span class="result-title" id="resFreeLook">150</span>
        </div>

        <div class="result-item highlight-box">
            <span>Kích thước Nút Bắn (0-100):</span>
            <span class="result-title" style="color: #ff79c6; font-size: 18px;" id="resButton">45%</span>
        </div>

        <!-- Ô DPI sẽ ẩn/hiện dựa vào hệ điều hành -->
        <div class="result-item dpi-box" id="dpiContainer">
            <span>DPI Khuyên Dùng (Android):</span>
            <span style="color: #bd93f9; font-size: 18px;" id="resDpi">540</span>
        </div>
    </div>
</div>

<script>
    // Database chuẩn cho một số máy phổ biến
    const database = {
        "iphone 11": { look: 195, redDot: 185, scope2x: 175, scope4x: 165, sniper: 120, freeLook: 150, button: 42, dpi: null },
        "iphone 13 pro max": { look: 180, redDot: 170, scope2x: 160, scope4x: 150, sniper: 100, freeLook: 130, button: 48, dpi: null },
        "redmi note 10": { look: 198, redDot: 190, scope2x: 185, scope4x: 175, sniper: 130, freeLook: 160, button: 50, dpi: 480 },
        "samsung ultra": { look: 190, redDot: 180, scope2x: 170, scope4x: 160, sniper: 110, freeLook: 140, button: 45, dpi: 520 },
        "rog phone 5": { look: 185, redDot: 175, scope2x: 165, scope4x: 155, sniper: 105, freeLook: 135, button: 46, dpi: 600 }
    };

    // Hàm kiểm tra thiết bị có phải iOS không
    function isIOSDevice(deviceName) {
        const iosKeywords = ["iphone", "ipad", "ip", "ios", "apple"];
        return iosKeywords.some(keyword => deviceName.toLowerCase().includes(keyword));
    }

    // Tự sinh cấu hình phù hợp nếu nhập máy chưa có trong DB
    function generateSensitivity(deviceName, isIOS) {
        let hash = 0;
        for (let i = 0; i < deviceName.length; i++) {
            hash = deviceName.charCodeAt(i) + ((hash << 5) - hash);
        }
        
        const getVal = (min, max, offset) => Math.abs((hash + offset) % (max - min + 1)) + min;

        return {
            look: getVal(170, 200, 1),
            redDot: getVal(160, 195, 2),
            scope2x: getVal(150, 190, 3),
            scope4x: getVal(140, 185, 4),
            sniper: getVal(90, 150, 5),
            freeLook: getVal(100, 180, 6),
            button: getVal(40, 58, 7),
            dpi: isIOS ? null : getVal(420, 650, 8) // DPI cho Android nằm trong khoảng 420-650
        };
    }

    function getSensitivity() {
        const input = document.getElementById("deviceInput").value.trim();
        if (!input) {
            alert("Vui lòng nhập tên thiết bị!");
            return;
        }

        const inputLower = input.toLowerCase();
        const isIOS = isIOSDevice(inputLower);

        let data = database[inputLower];
        if (!data) {
            data = generateSensitivity(inputLower, isIOS);
        }

        // Hiển thị dữ liệu
        document.getElementById("resDevice").innerText = input.toUpperCase();
        document.getElementById("resLook").innerText = data.look;
        document.getElementById("resRedDot").innerText = data.redDot;
        document.getElementById("res2x").innerText = data.scope2x;
        document.getElementById("res4x").innerText = data.scope4x;
        document.getElementById("resSniper").innerText = data.sniper;
        document.getElementById("resFreeLook").innerText = data.freeLook;
        document.getElementById("resButton").innerText = data.button + "%";

        // Xử lý ẩn/hiện DPI dựa vào hệ điều hành
        const dpiContainer = document.getElementById("dpiContainer");
        if (isIOS || data.dpi === null) {
            dpiContainer.style.display = "none"; // Ẩn hoàn toàn ô DPI với iOS
        } else {
            dpiContainer.style.display = "flex"; // Hiện ô DPI với Android
            document.getElementById("resDpi").innerText = data.dpi;
        }

        document.getElementById("resultBox").style.display = "block";
    }

    function checkEnter(event) {
        if (event.key === "Enter") {
            getSensitivity();
        }
    }
</script>

</body>
</html>
